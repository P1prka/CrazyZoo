<Window x:Class="CrazyZoo.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo - Vol.2"
        Height="720"
        Width="1080"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,16">
                <TextBlock Text="Crazy Zoo"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Vol.2 - Generics, LINQ, Events, MVVM"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>

            
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,0,14">

                <StackPanel>
                    <TextBlock Text="Add animal"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Animal type:"/>

                    <ComboBox Height="32"
                              Margin="0,5,0,12"
                              ItemsSource="{Binding AnimalTypes}"
                              SelectedItem="{Binding SelectedType, Mode=TwoWay}"/>

                    <TextBlock Text="Name:"/>

                    <TextBox Height="32"
                             Margin="0,5,0,12"
                             Text="{Binding AnimalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Energy (0-100):"/>

                    <TextBox Height="32"
                             Margin="0,5,0,14"
                             Text="{Binding EnergyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="Add animal"
                            Height="38"
                            FontWeight="SemiBold"
                            Background="#C7E9DD"
                            BorderBrush="#A7D8C8"
                            Command="{Binding AddCommand}"/>
                </StackPanel>
            </Border>

          
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Animals"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1"
                               Text="Search by name:"
                               Margin="0,0,0,5"/>

                    <TextBox Grid.Row="2"
                             Height="30"
                             Margin="0,0,0,10"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Grid.Row="3"
                              Height="30"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SortMode, Mode=TwoWay}"/>

                    <ListBox Grid.Row="4"
                             MinHeight="70"
                             BorderBrush="#E5E7EB"
                             ItemsSource="{Binding VisibleAnimals}"
                             SelectedItem="{Binding SelectedAnimal, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="5"
                               Text="{Binding StatisticsText}"
                               TextWrapping="Wrap"
                               Foreground="#4B5563"
                               Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

    
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>
                    <TextBlock Text="Selected animal"
                               FontSize="21"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="{Binding SelectedDescription}"
                               FontSize="17"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Energy"
                               FontWeight="SemiBold"/>


                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="22"
                                 Margin="0,7,0,6"
                                 Value="{Binding SelectedEnergy, Mode=OneWay}"/>    


                    <TextBlock Text="{Binding SelectedEnergyText}"
                               Foreground="#6B7280"
                               Margin="0,0,0,20"/>

                    <WrapPanel>
                        <Button Content="Normal action"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding NormalCommand}"/>

                        <Button Content="Crazy action"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding CrazyCommand}"/>

                        <Button Content="Swim"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding SwimCommand}"/>

                        <Button Content="Perform"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding PerformCommand}"/>

                        <Button Content="Remove animal"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#FCE0E0"
                                Command="{Binding RemoveCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>


            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,14">

                        <Button DockPanel.Dock="Right"
                                Content="Clear log"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding ClearLogCommand}"/>

                        <TextBlock Text="Event log"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding LogMessages}"
                             BorderThickness="0"
                             FontSize="13"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
