<Window x:Class="CrazyZoo.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>

        <Style x:Key="MainButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Margin"
                    Value="0,0,8,8"/>

            <Setter Property="Padding"
                    Value="12,5"/>

            <Setter Property="FontSize"
                    Value="14"/>

        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <StackPanel Grid.Column="0">

            <TextBlock Text="Crazy Zoo🐾"
                       FontSize="30"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Create your own unusual zoo"
                       Foreground="Gray"
                       Margin="0,0,0,20"/>

            <Border Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Add animal"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Name:"/>

                    <TextBox x:Name="NameTextBox"
                             Height="30"
                             Margin="0,5,0,12"/>

                    <TextBlock Text="Energy:"/>

                    <TextBox x:Name="EnergyTextBox"
                             Height="30"
                             Text="50"
                             Margin="0,5,0,12"/>

                    <TextBlock Text="Animal type:"/>

                    <ComboBox x:Name="AnimalTypeComboBox"
                              Height="30"
                              Margin="0,5,0,15">

                        <ComboBoxItem Content="Lion"/>
                        <ComboBoxItem Content="Zebra"/>
                        <ComboBoxItem Content="Giraffe"/>
                        <ComboBoxItem Content="Hippo"/>
                        <ComboBoxItem Content="Penguin"/>

                    </ComboBox>

                    <Button Content="Add animal"
                            Style="{StaticResource MainButtonStyle}"
                            Click="AddAnimal_Click"/>

                </StackPanel>

            </Border>

            <TextBlock Text="Animals"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <ListBox x:Name="AnimalListBox"
                     Height="250"
                     SelectionChanged="AnimalListBox_SelectionChanged"/>

        </StackPanel>

        
        <StackPanel Grid.Column="2">

            <Border Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="Selected animal"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="SelectedAnimalTextBlock"
                               Text="No animal selected."
                               FontSize="17"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Energy⚡"
                               FontWeight="Bold"/>

                    <ProgressBar x:Name="EnergyProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="22"
                                 Margin="0,5,0,5"/>

                    <TextBlock x:Name="EnergyTextBlock"
                               Text="0 / 100"
                               Margin="0,0,0,20"/>

                    <WrapPanel>

                        <Button Content="Normal action😊"
                                Style="{StaticResource MainButtonStyle}"
                                Click="NormalAction_Click"/>

                        <Button Content="Crazy action🤪"
                                Style="{StaticResource MainButtonStyle}"
                                Click="CrazyAction_Click"/>

                        <Button x:Name="SwimButton"
                                Content="Swim🌊"
                                Style="{StaticResource MainButtonStyle}"
                                Click="Swim_Click"/>

                        <Button x:Name="PerformButton"
                                Content="Perform🎉"
                                Style="{StaticResource MainButtonStyle}"
                                Click="Perform_Click"/>

                        <Button Content="Remove"
                                Style="{StaticResource MainButtonStyle}"
                                Click="Remove_Click"/>

                        <Button Content="Clear log"
                                Style="{StaticResource MainButtonStyle}"
                                Click="ClearLog_Click"/>
                    </WrapPanel>

                </StackPanel>

            </Border>

            <Border Background="White"
                    CornerRadius="8"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Action log"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="LogListBox"
                             Height="250"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>
</Window>