<Window x:Class="CrazyZoo.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crazy Zoo - Vol.4"
        Height="880"
        Width="1200"
        WindowState="Maximized"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>

        <Style x:Key="GreenButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="BlueButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PurpleButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="BorderBrush" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="RedButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="10">

        <TabItem Header="🐾 Zoo">
            <ScrollViewer Margin="14"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <Grid MinHeight="780"
                      MinWidth="860"
                      Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                      Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1"
                        Width="2"
                        Background="#CBD5E1"
                        HorizontalAlignment="Center"/>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                Margin="0,0,0,16">
                            <TextBlock Text="🐾 Crazy Zoo"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"/>

                            <TextBlock Text="Vol.4 - MVVM, Async, JSON, XML, LocalDB, DI"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,14">

                            <StackPanel>
                                <Border BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8"
                                    Margin="0,0,0,12">
                                    <TextBlock Text="➕ Add animal"
                                           FontSize="19"
                                           FontWeight="Bold"/>
                                </Border>

                                <TextBlock Text="Animal type:"/>

                                <ComboBox Height="32"
                                      Margin="0,5,0,12"
                                      ItemsSource="{Binding AnimalTypes}"
                                      SelectedItem="{Binding SelectedType, Mode=TwoWay}"/>

                                <TextBlock Text="Name:"/>

                                <TextBox Height="32"
                                     Margin="0,5,0,12"
                                     Text="{Binding AnimalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Energy (0-100):"/>

                                <TextBox Height="32"
                                     Margin="0,5,0,12"
                                     Text="{Binding EnergyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Group (new animal / change group):"/>

                                <ComboBox Height="32"
                                      Margin="0,5,0,14"
                                      ItemsSource="{Binding Groups}"
                                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"/>

                                <Button Content="➕ Add animal"
                                    Style="{StaticResource GreenButton}"
                                    Height="38"
                                    Margin="0"
                                    FontWeight="SemiBold"
                                    Command="{Binding AddCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8"
                                    Margin="0,0,0,12">
                                    <TextBlock Text="🦁 Animals"
                                           FontSize="19"
                                           FontWeight="Bold"/>
                                </Border>

                                <TextBlock Grid.Row="1"
                                       Text="Search by name:"
                                       Margin="0,0,0,5"/>

                                <TextBox Grid.Row="2"
                                     Height="30"
                                     Margin="0,0,0,10"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <ComboBox Grid.Row="3"
                                      Height="30"
                                      Margin="0,0,0,12"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SortMode, Mode=TwoWay}"/>

                                <ListBox Grid.Row="4"
                                     MinHeight="70"
                                     BorderBrush="#E5E7EB"
                                     ItemsSource="{Binding VisibleAnimals}"
                                     SelectedItem="{Binding SelectedAnimal, Mode=TwoWay}"/>

                                <TextBlock Grid.Row="5"
                                       Text="{Binding StatisticsText}"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563"
                                       Margin="0,12,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                            <StackPanel>
                                <Border BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8"
                                    Margin="0,0,0,12">
                                    <TextBlock Text="⭐ Selected animal"
                                           FontSize="21"
                                           FontWeight="Bold"/>
                                </Border>

                                <TextBlock Text="{Binding SelectedDescription}"
                                       FontSize="17"
                                       Margin="0,0,0,16"/>

                                <TextBlock Text="Energy"
                                       FontWeight="SemiBold"/>

                                <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Height="22"
                                         Margin="0,7,0,6"
                                         Value="{Binding SelectedEnergy, Mode=OneWay}"/>

                                <TextBlock Text="{Binding SelectedEnergyText}"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,12"/>

                                <Separator Margin="0,0,0,14"/>

                                <WrapPanel>
                                    <Button Content="🍌 Normal action"
                                        Style="{StaticResource GreenButton}"
                                        Command="{Binding NormalCommand}"/>

                                    <Button Content="🤪 Crazy action"
                                        Style="{StaticResource PurpleButton}"
                                        Command="{Binding CrazyCommand}"/>

                                    <Button Content="🏊 Swim"
                                        Style="{StaticResource BlueButton}"
                                        Command="{Binding SwimCommand}"/>

                                    <Button Content="🎭 Perform"
                                        Style="{StaticResource BlueButton}"
                                        Command="{Binding PerformCommand}"/>

                                    <Button Content="🔄 Change group"
                                        Style="{StaticResource BlueButton}"
                                        Command="{Binding ChangeGroupCommand}"/>

                                    <Button Content="🗑 Remove animal"
                                        Style="{StaticResource RedButton}"
                                        Command="{Binding RemoveCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8"
                                    Margin="0,0,0,12">
                                    <DockPanel>

                                        <Button DockPanel.Dock="Right"
                                        Content="🧹 Clear log"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="8,0,0,0"
                                        Command="{Binding ClearLogCommand}"/>

                                        <TextBlock Text="📜 Event log"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <ListBox Grid.Row="1"
                                     x:Name="LogListBox"
                                     ItemsSource="{Binding LogMessages}"
                                     BorderThickness="0"
                                     FontSize="13"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="⚡ Calculations (Vol.3)">
            <ScrollViewer Margin="14"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <Grid MinHeight="520"
                      MinWidth="860"
                      Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                      Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1"
                        Width="2"
                        Background="#CBD5E1"
                        HorizontalAlignment="Center"/>

                    <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,8"
                                Margin="0,0,0,12">
                                <TextBlock Text="⚡ Energy forecast"
                                       FontSize="19"
                                       FontWeight="Bold"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                   Text="Select animals:"
                                   Margin="0,0,0,5"/>

                            <ListBox Grid.Row="2"
                                 MinHeight="80"
                                 BorderBrush="#E5E7EB"
                                 ItemsSource="{Binding CalculationItems}"
                                 IsEnabled="{Binding IsNotBusy}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Text}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="3"
                                   Text="Workload (1-50):"
                                   Margin="0,12,0,5"/>

                            <TextBox Grid.Row="4"
                                 Height="30"
                                 Margin="0,0,0,12"
                                 IsEnabled="{Binding IsNotBusy}"
                                 Text="{Binding WorkloadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <WrapPanel Grid.Row="5">
                                <Button Content="▶ Sequential"
                                    Style="{StaticResource BlueButton}"
                                    Command="{Binding RunSequentialCommand}"/>

                                <Button Content="⚡ Parallel"
                                    Style="{StaticResource PurpleButton}"
                                    Command="{Binding RunParallelCommand}"/>

                                <Button Content="⛔ Cancel"
                                    Style="{StaticResource RedButton}"
                                    Command="{Binding CancelCommand}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,8"
                                Margin="0,0,0,12">
                                <TextBlock Text="📊 Report"
                                       FontSize="21"
                                       FontWeight="Bold"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                   Text="{Binding CalculationStatus}"
                                   Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2"
                                   Text="{Binding ComparisonText}"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                            <ProgressBar Grid.Row="3"
                                     Height="10"
                                     Margin="0,0,0,10"
                                     IsIndeterminate="{Binding IsBusy, Mode=OneWay}"/>

                            <ListBox Grid.Row="4"
                                 x:Name="ReportListBox"
                                 ItemsSource="{Binding ReportLines}"
                                 BorderThickness="0"
                                 FontSize="13"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="💾 Storage (Vol.4)">
            <ScrollViewer Margin="14"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <Grid MinHeight="520"
                      MinWidth="860"
                      Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                      Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1"
                        Width="2"
                        Background="#CBD5E1"
                        HorizontalAlignment="Center"/>

                    <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                        <StackPanel>
                            <Border BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,8"
                                Margin="0,0,0,12">
                                <TextBlock Text="💾 Save / load world"
                                       FontSize="19"
                                       FontWeight="Bold"/>
                            </Border>

                            <TextBlock Text="{Binding StorageInfo}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                            <TextBlock Text="File storage: choose .json or .xml in the dialog. LocalDB storage: data is saved to the database."
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button Content="💾 Save world"
                                    Style="{StaticResource GreenButton}"
                                    Command="{Binding SaveCommand}"/>

                                <Button Content="📂 Load world"
                                    Style="{StaticResource BlueButton}"
                                    Command="{Binding LoadCommand}"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding StorageStatus}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,8"
                                Margin="0,0,0,12">
                                <TextBlock Text="🌍 Current world"
                                       FontSize="21"
                                       FontWeight="Bold"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                   Text="Id | Type | Name | Energy | Group"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,8"/>

                            <ListBox Grid.Row="2"
                                 ItemsSource="{Binding WorldLines}"
                                 BorderThickness="0"
                                 FontSize="13"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>